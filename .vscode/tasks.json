{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "crear carpetas bin/obj",
      "type": "process",
      "command": "cmd",
      "args": [
        "/C",
        "if not exist ${fileDirname}\\obj mkdir ${fileDirname}\\obj & if not exist ${fileDirname}\\bin mkdir ${fileDirname}\\bin"
      ],
      "presentation": {
        "reveal": "silent"
      }
    },
    {
      "label": "compilar objeto (.o)",
      "type": "process",
      "command": "C:/msys64/mingw64/bin/clang.exe",
      "args": [
        "-std=c11",
        "-Wall",
        "-Wextra",
        "-Wpedantic",
        "-Wshadow",
        "-Wconversion",
        "-O2",
        "-c",
        "${file}",
        "-o",
        "${fileDirname}/obj/${fileBasenameNoExtension}.o"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "dependsOn": "crear carpetas bin/obj"
    },
    {
      "label": "build C (mingw64-clang, strict)",
      "type": "process",
      "command": "C:/msys64/mingw64/bin/clang.exe",
      "args": [
        "${fileDirname}/obj/${fileBasenameNoExtension}.o",
        "-o",
        "${fileDirname}/bin/${fileBasenameNoExtension}.exe"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "dependsOn": "compilar objeto (.o)"
    }
  ]
}
